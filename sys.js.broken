    if (!shown) return `瑼?鋆⊥? ${total} 蝑?雿飛?∪??格?撠鈭箝?寥??擗具?瑼Ｘ憪??;
    return `摰?嚗?獢ㄐ??${total} 蝑??芷＊蝷箏飛?∪??株ㄐ??${shown} 蝑;
  }
