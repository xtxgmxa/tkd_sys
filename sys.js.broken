    }
    if (!shown) {
      return getPlayerNames().length
        ? `瑼?鋆⊥? ${total} 蝑??祇尹?飛?∪??桅瘝??唬犖?
        : `瑼?鋆⊥? ${total} 蝑??祇尹瘝??唬犖?憟摮詨???;
    }
    return `摰?嚗?獢ㄐ??${total} 蝑?靘擗券＊蝷?${shown} 蝑;
  }
  if (mode === "either") {
    if (!shown) return `瑼?鋆⊥? ${total} 蝑??祇尹?飛?∪??桅瘝??唬犖?;
    return `摰?嚗?獢ㄐ??${total} 蝑??祇尹嚗飛?∪?蝮賡＊蝷?${shown} 蝑;
  }
  if (!shown) return `瑼?鋆⊥? ${total} 蝑?雿擗典?摮?撠鈭箝?寥???擗剁?瘝??唳??寧?摮詨?????典飛?∪??柴;
  return `摰?嚗?獢ㄐ??${total} 蝑?靘尹?仿??萄?憿舐內 ${shown} 蝑;
