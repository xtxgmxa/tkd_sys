let tourIndex = 0;

function markTourSeen() {
  try { localStorage.setItem(TOUR_SEEN_KEY, "1"); } catch (error) { /* ignore */ }
}

function renderTour() {
  const step = TOUR_STEPS[tourIndex];
  if (!step) return;
  const title = document.getElementById("tourTitle");
  const copy = document.getElementById("tourCopy");
  const stage = document.getElementById("tourStage");
  const label = document.getElementById("tourStepLabel");
  const dots = document.getElementById("tourDots");
  const prev = document.getElementById("tourPrevBtn");
  const next = document.getElementById("tourNextBtn");
  if (title) title.textContent = step.title;
  if (copy) copy.innerHTML = step.copy;
  if (stage) stage.innerHTML = step.stage;
  if (label) label.textContent = `${tourIndex + 1} / ${TOUR_STEPS.length}`;
  if (dots) {
    dots.innerHTML = TOUR_STEPS.map((_, index) =>
      `<button type="button" class="tour-dot ${index === tourIndex ? "active" : ""}" data-tour-step="${index}" aria-label="蝚?${index + 1} ??></button>`
    ).join("");
    dots.querySelectorAll(".tour-dot").forEach((dot) => {
      dot.addEventListener("click", () => {
        tourIndex = Number(dot.dataset.tourStep) || 0;
        renderTour();
      });
    });
  }
  if (prev) prev.disabled = tourIndex === 0;
  if (next) next.textContent = tourIndex === TOUR_STEPS.length - 1 ? "???" : "銝???;
}

function openTour() {
  tourIndex = 0;
  renderTour();
  document.getElementById("tourModal")?.classList.remove("hidden");
}

function closeTour() {
  markTourSeen();
  document.getElementById("tourModal")?.classList.add("hidden");
}

function maybeOpenTour() {
  try {
    if (localStorage.getItem(TOUR_SEEN_KEY) === "1") return;
  } catch (error) { return; }
  setTimeout(openTour, 500);
}

document.getElementById("openTourBtn")?.addEventListener("click", openTour);
document.getElementById("openTourBtn2")?.addEventListener("click", openTour);
document.getElementById("tourCloseBtn")?.addEventListener("click", closeTour);
document.getElementById("tourBackdrop")?.addEventListener("click", closeTour);
document.getElementById("tourPrevBtn")?.addEventListener("click", () => {
  if (tourIndex > 0) {
    tourIndex -= 1;
    renderTour();
  }
});
document.getElementById("tourNextBtn")?.addEventListener("click", () => {
  if (tourIndex >= TOUR_STEPS.length - 1) {
    closeTour();
    return;
  }
  tourIndex += 1;
  renderTour();
});


function escapeHTML(text) {
  return String(text ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function safeFileName(name) {
  return String(name || "鞈賜?")
    .replace(/[\\/:*?"<>|嚚/g, "_")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 80) || "鞈賜?";
}

function exportFileName(ext) {
  const competition = document.getElementById("competitionName").value.trim() || "鞈賜?";
  const club = clubName.value.trim() || "?祇尹";
  const extra = exportScope === "?" ? "-?" : exportScope === "撠?" ? "-撠?" : "";
  return `${safeFileName(`${competition}-${club}${extra}`)}.${ext}`;
}

function downloadWorkbook(wb, filename) {
  const name = safeFileName(String(filename || "鞈賜?").replace(/\.xlsx$/i, "")) + ".xlsx";
  try {
    const out = XLSX.write(wb, { bookType: "xlsx", type: "array" });
    downloadBlob(
      new Blob([out], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }),
      name
    );
  } catch (error) {
    try {
      XLSX.writeFile(wb, name);
    } catch (inner) {
      alert("?臬憭望?嚗? + (inner.message || error.message));
    }
  }
}

function classifyType(item) {
  if (isFight(item)) return "撠?";
  if (isPoomsae(item)) return "?";
  if (item.weightClass || /?祆|??/.test(item.division || "")) return "撠?";
  if (item.eventName || /蝡?/.test([item.division, item.detailLabel].join(""))) return "?";
  return item.type || "?嗡?";
}

function formatMatchExport(item) {
  if (isOrderStyle(item)) {
    const match = item.matchNo || "";
    const order = item.orderNo || item.seed;
    if (match && order) return `${match}嚗洵${order}雿?`;
    return match || (order ? `蝚?{order}雿 : "?芣???);
  }
  return formatColorSequence(item);
}

function sideExport(item) {
  if (isOrderStyle(item)) return "頛芣??箏";
  return displayValue(item.bye && !item.matchNo ? item.nextColor : item.color);
}

function opponentExport(item) {
  if (isOrderStyle(item)) return orderLabel(item);
  return displayValue(item.opponent);
}

function rowsForExport(data) {
  return data.map((item, index) => ({
    ??: index + 1,
    ?豢?: item.player || "?芣???,
    ?: displayValue(classifyType(item)),
    蝯: displayValue(item.division),
    撟湧翩撅? displayValue(item.ageGroup),
    ?批: displayValue(item.gender),
    蝝???ａ??? displayValue(isPoomsae(item) ? formatPoomsaeLabel(item) : item.detailLabel),
    撣嗉畾萇?: displayValue(item.belt),
    ?游: displayValue(item.court),
    ?砍?湔活: item.bye && !item.matchNo ? "頛芰征??" : displayValue(item.matchNo),
    ???? sideExport(item),
    撠?: opponentExport(item),
    撠??尹: isOrderStyle(item) ? "嚗? : displayValue(item.opponentClub),
    銝??游甈? isOrderStyle(item) ? "嚗? : displayValue(item.nextMatchNo),
    銝??湧?蝝? isOrderStyle(item) ? "嚗? : displayValue(item.nextColor),
    銝??游??? isOrderStyle(item) ? "嚗? : displayValue(item.nextOpponentHint),
    蝐方?: item.seed || "?芣???,
    ??鈭箸: item.groupSize || "?芣???,
    ?祇尹: displayValue(item.club)
  }));
}

let exportKind = "excel";
let exportPreviewTab = "all";
let exportScope = "both";
const EXPORT_PREVIEW_LIMIT = 12;

document.getElementById("exportExcelBtn").addEventListener("click", () => {
  if (!window.XLSX) {
    alert("Excel 憟辣撠頛嚗?蝣箄?蝬脰楝???");
    return;
  }
  if (!allData.length) {
    alert("瘝??臬?箇?鞈????圾??獢?銝衣Ⅱ隤?Ｖ??????);
    return;
  }
  openExportModal("excel");
});

document.getElementById("exportWordBtn").addEventListener("click", () => {
  if (!allData.length) {
    alert("瘝??臬?箇?鞈?");
    return;
  }
  openExportModal("word");
});

function openExportModal(kind) {
  exportKind = kind === "word" ? "word" : "excel";
  exportPreviewTab = "all";
  exportScope = (currentFilter === "?" || currentFilter === "撠?") ? currentFilter : "both";
  if (!poomsaeItems(allData).length) exportScope = fightItems(allData).length ? "撠?" : "both";
  else if (!fightItems(allData).length) exportScope = "?";
  const box = document.getElementById("exportFieldList");
  const modal = document.getElementById("exportModal");
  if (!box || !modal) {
    if (exportKind === "word") doExportWord();
    else doExportExcel();
    return;
  }
  const kicker = document.getElementById("exportKicker");
  const title = document.getElementById("exportTitle");
  const confirm = document.getElementById("exportConfirmBtn");
  if (kicker) kicker.textContent = exportKind === "word" ? "?臬 Word" : "?臬 Excel";
  if (title) title.textContent = "瘝?憿停銝?";
  if (confirm) confirm.textContent = exportKind === "word" ? "銝? Word" : "銝? Excel";
  document.getElementById("exportFieldsFold")?.classList.toggle("hidden", exportKind === "word");
  const sheetsTitle = document.getElementById("exportSheetsTitle");
  if (sheetsTitle) sheetsTitle.textContent = exportKind === "word" ? "???亦敦蝭" : "?陛銵券隞暻潭見摮?;
  const sheetsNote = document.getElementById("exportSheetsNote");
  if (sheetsNote) sheetsNote.textContent = exportKind === "word" ? "暺??臬???渲”???? : "瑼?鋆⊥靘停???ㄐ?芣??";
  setFoldOpen("exportScopeToggle", "exportScopePanel", false);
  setFoldOpen("exportSheetsToggle", "exportSheetsPanel", false);
  setFoldOpen("exportFieldsToggle", "exportFieldsPanel", false);
  box.innerHTML = EXPORT_FIELDS.map((field) => `
    <label class="check-chip">
      <input type="checkbox" value="${escapeHTML(field.key)}" ${exportFields.includes(field.key) ? "checked" : ""} />
      <span>${escapeHTML(field.label)}</span>
    </label>
  `).join("");
  renderExportScope();
  renderExportTabs();
  renderExportPreview();
  modal.classList.remove("hidden");
}

function collectExportFields() {
  const checked = [...document.querySelectorAll("#exportFieldList input[type=checkbox]:checked")].map((input) => input.value);
  return checked.filter((key) => EXPORT_FIELDS.some((item) => item.key === key));
}

function liveExportFields() {
  const modal = document.getElementById("exportModal");
  if (modal && !modal.classList.contains("hidden")) {
    const checked = collectExportFields();
    return EXPORT_FIELDS.filter((field) => checked.includes(field.key));
  }
  return EXPORT_FIELDS.filter((field) => exportFields.includes(field.key));
}

function poomsaeItems(data) {
  return (data || []).filter((item) => classifyType(item) === "?");
}

function fightItems(data) {
  return (data || []).filter((item) => classifyType(item) === "撠?");
}

function exportHasBothTypes() {
  return poomsaeItems(allData).length > 0 && fightItems(allData).length > 0;
}

function exportItems() {
  if (exportScope === "?") return poomsaeItems(allData);
  if (exportScope === "撠?") return fightItems(allData);
  return allData.slice();
}

function renderExportScope() {
  const fold = document.getElementById("exportScopeFold");
  const box = document.getElementById("exportScopeBlock");
  const show = exportHasBothTypes();
  fold?.classList.toggle("hidden", !show);
  if (!box) return;
  box.querySelectorAll("[data-export-scope]").forEach((btn) => {
    btn.classList.toggle("active", btn.getAttribute("data-export-scope") === exportScope);
  });
  const note = document.getElementById("exportScopeNote");
  if (note) {
    note.textContent = exportScope === "?"
      ? "?桀?嚗?箏???
      : exportScope === "撠?"
        ? "?桀?嚗?箏???
        : "撟喳虜銝?對??拍車?賢嚗???";
  }
}

function exportSummaryText() {
  const n = exportItems().length;
  const both = exportHasBothTypes() && exportScope === "both";
  if (exportKind === "word") {
    if (both) return `???${n} 蝑??Ｕ???????瘜Ｘ活????撠望?銝??;
    return `???${n} 蝑?靘郭甈⊥?摨???撠望?銝??;
  }
  if (both) return `???${n} 蝑??Ｕ???銝撘菔底蝝啗”嚗???渡?陛銵具???撠望?銝??;
  if (exportScope === "?") return `?芸?嚗 ${n} 蝑?靘郭甈⊥?摨;
  if (exportScope === "撠?") return `?芸撠?嚗 ${n} 蝑?靘郭甈⊥?摨;
  return `???${n} 蝑?靘郭甈⊥?摨???撠望?銝??;
}

function exportSheetsOpen() {
  return !document.getElementById("exportSheetsPanel")?.classList.contains("hidden");
}

function renderExportTabs() {
  const tabs = document.getElementById("exportTabs");
  if (!tabs) return;
  const items = exportKind === "word"
    ? [
        { id: "all", label: exportScope === "both" ? "?箏銵剁??嚗?????" : "?箏銵? },
        { id: "groups", label: "蝯蝝啁?" }
      ]
    : [
        { id: "all", label: exportScope === "both" ? "閰喟敦鞈賜?嚗???" : "閰喟敦鞈賜?" },
        (exportScope !== "撠?" && poomsaeItems(exportItems()).length) ? { id: "poomsae", label: "?蝪∟”" } : null,
        (exportScope !== "?" && fightItems(exportItems()).length) ? { id: "fight", label: "撠?蝪∟”" } : null
      ].filter(Boolean);
  if (!items.some((item) => item.id === exportPreviewTab)) exportPreviewTab = items[0]?.id || "all";
  tabs.innerHTML = items.map((item) => `
    <button type="button" class="export-tab ${item.id === exportPreviewTab ? "active" : ""}" data-export-tab="${item.id}">${item.label}</button>
  `).join("");
  const note = document.getElementById("exportTabNote");
  if (note) {
    const notes = {
      all: exportKind === "word"
        ? (exportScope === "both" ? "???Ｕ?撠???靘郭甈⊥?摨?銝?瘛瑕??撘菔”?? : "靘郭甈⊥?摨?)
        : (exportScope === "both"
          ? "????????拙撐撌乩?銵剁???瘜Ｘ活?????Ｗ??雿撘菟?拍??
          : "?撐閰喟敦鞈賜?靘郭甈⊥?摨??Ｗ??雿敶梢?撐銵具?),
      groups: "蝯蝝啁?嚗?蝯??狐?惜?甈～?,
      poomsae: "?蝪∟”嚗策銝????????乓甈～??ｇ?甈??箏?銝?整?,
      fight: "撠?蝪∟”嚗策銝????????乓甈∴???嚗?雿摰??賢??
    };
    note.textContent = notes[exportPreviewTab] || "";
  }
}

function renderExportPreview() {
  const host = document.getElementById("exportPreview");
  const fileHint = document.getElementById("exportFileHint");
  const summary = document.getElementById("exportSummary");
  if (summary) summary.textContent = exportSummaryText();
  if (fileHint) fileHint.textContent = `撠?頛?${exportFileName(exportKind === "word" ? "doc" : "xlsx")}`;
  if (!host) return;
  const club = clubName.value.trim() || "?祇尹";
  const tab = exportSheetsOpen() ? exportPreviewTab : "all";
  if (exportKind === "word") {
    if (tab === "groups") {
      host.innerHTML = wordGroupsPreviewHtml();
      return;
    }
    const headers = ["??", "?豢?", "?", "蝯", "?????, "?游", "?砍", "??嚗??, "撠?嚗?摨?, "銝???];
    host.innerHTML = previewDetailBlocks(club, headers, (list) => rowsForExport(list).map(wordPreviewRow), "Word ?箏銵?);
    return;
  }
  const selected = liveExportFields();
  if (tab === "all") {
    if (!selected.length) {
      host.innerHTML = `<p class="export-preview-empty">隢撠?訾???雿?/p>`;
      return;
    }
    const headers = selected.map((field) => field.label);
    host.innerHTML = previewDetailBlocks(
      club,
      headers,
      (list) => rowsForExport(list).map((row) => selected.map((field) => row[field.key] ?? "")),
      "閰喟敦鞈賜?"
    );
    return;
  }
  if (tab === "poomsae") {
    host.innerHTML = previewTableHtml(
      ["憪?", "蝯", "?湔活", "蝚砌??", "蝚砌??", "瘥魚?"],
      poomsaeExportRows(exportItems()),
      `${club}嚚??Ｙ陛銵灼
    );
    return;
  }
  host.innerHTML = previewTableHtml(
    ["憪?", "擃?嚗???, "?湔活嚗???],
    fightExportRows(exportItems()),
    `${club}嚚??陛銵灼
  );
}

function previewDetailBlocks(club, headers, rowFn, kind) {
  const poom = poomsaeItems(exportItems());
  const fight = fightItems(exportItems());
  if (exportScope !== "both") {
    const label = exportScope === "?" ? "?" : exportScope === "撠?" ? "撠?" : "";
    return previewTableHtml(headers, rowFn(exportItems()), `${club}嚚?{kind}${label ? "-" + label : ""}嚗?瘜Ｘ活嚗);
  }
  const parts = [];
  if (poom.length) parts.push(previewTableHtml(headers, rowFn(poom), `${club}嚚?{kind}-?嚗?瘜Ｘ活嚗));
  if (fight.length) parts.push(previewTableHtml(headers, rowFn(fight), `${club}嚚?{kind}-撠?嚗?瘜Ｘ活嚗));
  return parts.join("") || `<p class="export-preview-empty">瘝?鞈?</p>`;
}

function previewTableHtml(headers, rows, caption) {
  const shown = rows.slice(0, EXPORT_PREVIEW_LIMIT);
  const extra = rows.length > shown.length ? `嚗??ａ???${rows.length - shown.length} 蝑?撖恍脫?獢 : "";
  return `
    <p class="export-preview-meta">${escapeHTML(caption)}??汗??${shown.length} 蝑???${rows.length} 蝑?{extra}</p>
    <div class="export-preview-wrap">
      <table class="export-preview-table">
        <thead><tr>${headers.map((h) => `<th>${escapeHTML(h)}</th>`).join("")}</tr></thead>
        <tbody>
          ${shown.map((row) => `<tr>${row.map((cell) => `<td>${escapeHTML(String(cell ?? ""))}</td>`).join("")}</tr>`).join("") || `<tr><td colspan="${headers.length}">瘝?鞈?</td></tr>`}
        </tbody>
      </table>
    </div>
  `;
}

function wordPreviewRow(row) {
  const next = `${row.銝??游甈﹙${row.銝??湧?蝝?&& row.銝??湧?蝝?!== "嚗? && row.銝??湧?蝝?!== "?芣??? ? " " + row.銝??湧?蝝?: ""}`;
  return [row.??, row.?豢?, row.?, row.蝯, row.蝝???ａ??? row.?游, row.?砍?湔活, row.???? row.撠?, next];
}

function wordGroupsPreviewHtml() {
  const groups = getVisibleGroups(exportItems());
  const shown = groups.slice(0, 8);
  const extra = groups.length > shown.length ? `<p class="export-preview-meta">敺?? ${groups.length - shown.length} 蝯?撖恍脫?獢?/p>` : "";
  return `
    <p class="export-preview-meta">Word 蝯蝝啁???汗 ${shown.length} 蝯???${groups.length} 蝯?/p>
    <div class="export-preview-wrap">
      <div class="export-preview-groups">
        ${shown.map((group) => {
          const people = (group.members.length ? group.members : group.ours).slice(0, 8).map((item) =>
            `<li>${escapeHTML(displayValue(item.player))}嚗?{escapeHTML(displayValue(item.club))}嚗?/li>`
          ).join("");
          return `<div><h4>${escapeHTML(displayValue(group.type))} 嚚?${escapeHTML(displayValue(group.division))}</h4><ul>${people || "<li>?芣???/li>"}</ul></div>`;
        }).join("") || `<p class="export-preview-empty">瘝?蝯</p>`}
      </div>
    </div>
    ${extra}
  `;
}

function poomsaeExportRows(data) {
  return poomsaeItems(data || exportItems()).map((item) => [
    item.player || "",
    compactDivision(item),
    formatMatchExport(item),
    shortPoomsae(item.event1 || "") || (item.event2 ? "" : formatPoomsaeLabel(item, true)),
    shortPoomsae(item.event2 || ""),
    formatPoomsaeLabel(item, true)
  ]);
}

function fightExportRows(data) {
  return fightItems(data || exportItems()).map((item) => [
    item.player || "",
    compactDivision(item),
    formatColorSequence(item)
  ]);
}

function doExportExcel() {
  const club = clubName.value.trim() || "?祇尹";
  const workbook = XLSX.utils.book_new();
  const source = exportItems();
  const poomsae = poomsaeItems(source);
  const fight = fightItems(source);
  const other = source.filter((item) => classifyType(item) !== "?" && classifyType(item) !== "撠?");
  const selected = EXPORT_FIELDS.filter((field) => exportFields.includes(field.key));
  if (!selected.length) {
    alert("隢撠?訾???雿?);
    return;
  }

  const addDetailSheet = (title, items) => {
    if (!items.length) return;
    const rows = [
      [`${club}嚚?{title}`],
      selected.map((field) => field.label)
    ];
    rowsForExport(items).forEach((row) => {
      rows.push(selected.map((field) => row[field.key] ?? ""));
    });
    const sheet = XLSX.utils.aoa_to_sheet(rows);
    sheet["!cols"] = selected.map(() => ({ wch: 16 }));
    XLSX.utils.book_append_sheet(workbook, sheet, title.slice(0, 31));
  };

  if (exportScope === "both" && poomsae.length && fight.length) {
    addDetailSheet("閰喟敦鞈賜?-?", poomsae);
    addDetailSheet("閰喟敦鞈賜?-撠?", fight);
  } else {
    addDetailSheet(poomsae.length && !fight.length ? "閰喟敦鞈賜?-?" : fight.length && !poomsae.length ? "閰喟敦鞈賜?-撠?" : "閰喟敦鞈賜?", source);
  }

  if (poomsae.length) {
    const poomRows = [
      [`${club}嚚??Ｙ陛銵灼],
      ["憪?", "蝯", "?湔活", "蝚砌??", "蝚砌??", "瘥魚?"],
      ...poomsaeExportRows(poomsae)
    ];
    const poomSheet = XLSX.utils.aoa_to_sheet(poomRows);
    poomSheet["!cols"] = [12, 32, 16, 16, 16, 18].map((wch) => ({ wch }));
    XLSX.utils.book_append_sheet(workbook, poomSheet, "?蝪∟”");
  }

  if (fight.length) {
    const fightRows = [
      [`${club}嚚??陛銵灼],
      ["憪?", "擃?嚗???, "?湔活嚗???],
      ...fightExportRows(fight)
    ];
    const fightSheet = XLSX.utils.aoa_to_sheet(fightRows);
    fightSheet["!cols"] = [12, 32, 18].map((wch) => ({ wch }));
    XLSX.utils.book_append_sheet(workbook, fightSheet, "撠?蝪∟”");
  }

  if (other.length && !poomsae.length && !fight.length) {
    const extra = [
      [`${club}嚚隞],
      ["憪?", "?", "蝯", "?湔活"]
    ];
    other.forEach((item) => {
      extra.push([item.player || "", item.type || "", compactDivision(item), formatMatchExport(item)]);
    });
    XLSX.utils.book_append_sheet(workbook, XLSX.utils.aoa_to_sheet(extra), "?嗡?");
  }

  try {
    downloadWorkbook(workbook, exportFileName("xlsx"));
  } catch (error) {
    alert("?臬憭望?嚗? + error.message);
  }
}

function wordTableRows(list) {
  return rowsForExport(list).map((row) => `
    <tr>
      <td>${escapeHTML(row.??)}</td>
      <td>${escapeHTML(row.?豢?)}</td>
      <td>${escapeHTML(row.?)}</td>
      <td>${escapeHTML(row.蝯)}</td>
      <td>${escapeHTML(row.蝝???ａ???}</td>
      <td>${escapeHTML(row.?游)}</td>
      <td>${escapeHTML(row.?砍?湔活)}</td>
      <td>${escapeHTML(row.????}</td>
      <td>${escapeHTML(row.撠?)}</td>
      <td>${escapeHTML(row.銝??游甈?}${row.銝??湧?蝝?&& row.銝??湧?蝝?!== "嚗? && row.銝??湧?蝝?!== "?芣??? ? " " + escapeHTML(row.銝??湧?蝝? : ""}</td>
    </tr>
  `).join("");
}

function wordGroupsHtml(list) {
  return getVisibleGroups(list).map((group) => {
    const people = (group.members.length ? group.members : group.ours).map((item) =>
      `<li>${escapeHTML(displayValue(item.player))}嚗?{escapeHTML(displayValue(item.club))}嚗?
       蝐方?${item.seed || "?"} ${escapeHTML(isOrderStyle(item) ? orderLabel(item) : (item.color || ""))} ?湔活${escapeHTML(displayValue(item.matchNo))}
       ${isOrderStyle(item) ? "頛芣??箏" : "撠?嚗? + escapeHTML(displayValue(item.opponent))}
       ${isOrderStyle(item) ? "" : "銝??湛?" + escapeHTML(displayValue(item.nextMatchNo)) + " " + escapeHTML(item.nextColor || "")}</li>`
    ).join("");
    return `<h3>${escapeHTML(displayValue(group.type))} 嚚?${escapeHTML(displayValue(group.division))}</h3><ul>${people}</ul>`;
  }).join("");
}

function doExportWord() {
  const competition = document.getElementById("competitionName").value || "鞈賜?";
  const club = clubName.value || "?祇尹";
  const source = exportItems();
  const poom = poomsaeItems(source);
  const fight = fightItems(source);
  const tableHead = `
          <tr>
            <th>??</th><th>?豢?</th><th>?</th><th>蝯</th>
            <th>蝝 / ??</th><th>?游</th><th>?砍</th><th>??嚗??/th><th>撠?嚗?摨?/th><th>銝???/th>
          </tr>`;
  const tables = exportScope === "both" && poom.length && fight.length
    ? `<h2>?嚗?瘜Ｘ活嚗?/h2><table>${tableHead}${wordTableRows(poom)}</table>
        <h2>撠?嚗?瘜Ｘ活嚗?/h2><table>${tableHead}${wordTableRows(fight)}</table>`
    : `<table>${tableHead}${wordTableRows(source)}</table>`;
  const groups = exportScope === "both" && poom.length && fight.length
    ? `<h2>?蝯</h2>${wordGroupsHtml(poom)}<h2>撠?蝯</h2>${wordGroupsHtml(fight)}`
    : wordGroupsHtml(source);

  const html = `
    <html>
      <head>
        <meta charset="utf-8">
        <title>${escapeHTML(competition)}</title>
        <style>
          body { font-family: "Microsoft JhengHei", sans-serif; }
          table { border-collapse: collapse; width: 100%; }
          th, td { border: 1px solid #333; padding: 6px 8px; font-size: 12px; }
          th { background: #eee; }
        </style>
      </head>
      <body>
        <h1>${escapeHTML(competition)}</h1>
        <p>?尹嚗?{escapeHTML(club)}</p>
        <p>?豢? ${[...new Set(source.map((item) => item.player))].length} 鈭綽??箏 ${source.length} ?氬?/p>
        ${tables}
        <h2>蝯蝝啁?</h2>
        ${groups}
      </body>
    </html>
  `;

  downloadBlob(
    new Blob(["\ufeff", html], { type: "application/msword" }),
    exportFileName("doc")
  );
}

function formatColorSequence(item) {
  const parts = [];
  if (item.bye && !item.matchNo && item.nextMatchNo) {
    parts.push(`${item.nextMatchNo}${shortColor(item.nextColor)}`);
    return parts.join("??);
  }
  if (item.matchNo) parts.push(`${item.matchNo}${shortColor(item.color)}`);
  if (item.nextMatchNo) parts.push(`${item.nextMatchNo}${shortColor(item.nextColor)}`);
  return parts.filter(Boolean).join("??) || "?芣???;
}

function shortPoomsae(text) {
  return String(text || "")
    .replace(/?芣???g, "")
    .replace(/憭芣扔/g, "")
    .replace(/???g, "???)
    .trim();
}

function compactDivision(item) {
  const text = [item.ageGroup, item.gender, item.division, item.weightClass]
    .filter(Boolean)
    .join("");
  return (item.division || text || "").replace(/瘥魚蝯:?/g, "").trim() || "?芣???;
}

function bindFold(toggleId, panelId) {
  const toggle = document.getElementById(toggleId);
  const panel = document.getElementById(panelId);
  if (!toggle || !panel) return;
  toggle.addEventListener("click", () => {
    const open = panel.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    const arrow = toggle.querySelector(".fold-arrow");
    if (arrow) arrow.textContent = open ? "嚗? : "嚗?;
  });
}

function setFoldOpen(toggleId, panelId, open) {
  const toggle = document.getElementById(toggleId);
  const panel = document.getElementById(panelId);
  if (!toggle || !panel) return;
  panel.classList.toggle("hidden", !open);
  toggle.setAttribute("aria-expanded", open ? "true" : "false");
  const arrow = toggle.querySelector(".fold-arrow");
  if (arrow) arrow.textContent = open ? "嚗? : "嚗?;
}

